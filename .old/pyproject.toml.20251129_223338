[build-system]
requires = ["setuptools>=42", "wheel"]
build-backend = "setuptools.build_meta"

[project]
name = "dars_framework"
version = "1.5.3"
description = "Dars is a Python UI framework for building modern, interactive web apps with only Python code. Write your interface in Python, export it to static HTML/CSS/JS, and deploy anywhere."
readme = "README.md"
license = {text = "MPL-2.0"}
requires-python = ">=3.11"
keywords = [
    "ui-framework",
    "web-framework",
    "python-ui",
    "static-site-generator",
    "html-css-js",
    "reactive",
    "components",
    "spa",
    "web-development",
    "desktop-apps",
    "electron"
]
authors = [
    {name = "ztamdev", email = "ztadevs@gmail.com"}
]
maintainers = [
    {name = "ztamdev", email = "ztadevs@gmail.com"}
]
classifiers = [
    # Development Status
    "Development Status :: 4 - Beta",
    
    # Intended Audience
    "Intended Audience :: Developers",
    
    # Topic
    "Topic :: Software Development :: User Interfaces",
    "Topic :: Software Development :: Libraries :: Python Modules",
    "Topic :: Internet :: WWW/HTTP :: Dynamic Content",
    "Topic :: Internet :: WWW/HTTP :: Site Management",
    
    # License
    "License :: OSI Approved :: Mozilla Public License 2.0 (MPL-2.0)",
    
    # Python Versions
    "Programming Language :: Python :: 3",
    "Programming Language :: Python :: 3.11",
    "Programming Language :: Python :: 3.12",
    "Programming Language :: Python :: 3.13",
    "Programming Language :: Python :: 3 :: Only",
    
    # OS
    "Operating System :: OS Independent",
    
    # Framework
    "Framework :: FastAPI",
    
    # Typing
    "Typing :: Typed",
    
    # Natural Language
    "Natural Language :: English",
]

dependencies = [
    "rich==14.2.0",
    "bs4==0.0.2",
    "uvicorn==0.38.0",
    "markdown2==2.5.4",
    "requests==2.32.5",
    "plotly==5.18.0",
]

[project.optional-dependencies]
dev = ["pandas==2.2.2"]

[project.urls]
Homepage = "https://ztamdev.github.io/Dars-Framework/"
Documentation = "https://ztamdev.github.io/Dars-Framework/docs.html"
Repository = "https://github.com/ZtaMDev/Dars-Framework"
"Bug Tracker" = "https://github.com/ZtaMDev/Dars-Framework/issues"
Changelog = "https://github.com/ZtaMDev/Dars-Framework/releases"

[project.scripts]
dars = "dars.cli.main:main"

[tool.setuptools.packages.find]
include = ["dars*"]
exclude = ["LandingPage*"]
