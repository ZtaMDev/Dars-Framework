{
  "type": "module",
  "name": "dars_framework",
  "version": "1.7.9",
  "description": "Dars is a Full-Stack multiplatform Python UI framework for building modern, interactive web and desktop apps with Python code. Seamlessly integrated with FastAPI, it allows you to build complete applications with Server-Side Rendering (SSR) and reactive SPA capabilities also classic multipage html and desktop apps in a single codebase.",
  "authors": [
    {
      "name": "ztamdev",
      "email": "ztadevs@gmail.com"
    }
  ],
  "license": "MPL-2.0",
  "dependencies": {
    "rich": "==14.2.0",
    "bs4": "==0.0.2",
    "uvicorn": "==0.38.0",
    "markdown2": "==2.5.4",
    "requests": "==2.32.5",
    "plotly": "==5.18.0",
    "fastapi": "==0.121.1"
  },
  "devDependencies": {},
  "optionalDependencies": {},
  "scripts": {},
  "cli": {
    "dars": "dars.cli.main:main"
  },
  "pyproject": {
    "project.readme": "README.md",
    "project.license": {
      "text": "MPL-2.0"
    },
    "project.requires-python": ">=3.11",
    "project.keywords": [
      "ui-framework",
      "web-framework",
      "python-ui",
      "static-site-generator",
      "html-css-js",
      "reactive",
      "components",
      "spa",
      "web-development",
      "desktop-apps",
      "electron"
    ],
    "project.maintainers": [
      {
        "name": "ztamdev",
        "email": "ztadevs@gmail.com"
      }
    ],
    "project.classifiers": [
      "Intended Audience :: Developers",
      "Topic :: Software Development :: User Interfaces",
      "Topic :: Software Development :: Libraries :: Python Modules",
      "Topic :: Internet :: WWW/HTTP :: Dynamic Content",
      "Topic :: Internet :: WWW/HTTP :: Site Management",
      "Programming Language :: Python :: 3",
      "Programming Language :: Python :: 3.11",
      "Programming Language :: Python :: 3.12",
      "Programming Language :: Python :: 3.13",
      "Programming Language :: Python :: 3.14",
      "Programming Language :: Python :: 3 :: Only",
      "Operating System :: OS Independent",
      "Typing :: Typed",
      "Natural Language :: English"
    ],
    "project.urls": {
      "Homepage": "https://ztamdev.github.io/Dars-Framework/",
      "Documentation": "https://ztamdev.github.io/Dars-Framework/docs.html",
      "Repository": "https://github.com/ZtaMDev/Dars-Framework",
      "Bug Tracker": "https://github.com/ZtaMDev/Dars-Framework/issues",
      "Changelog": "https://github.com/ZtaMDev/Dars-Framework/releases"
    },
    "tool": {
      "setuptools": {
        "packages": {
          "find": {
            "include": [
              "dars*"
            ],
            "exclude": [
              "LandingPage*"
            ]
          }
        }
      }
    }
  },
  "useGlobalDeps": false,
  "autoResolveConflicts": false,
  "autoResolveStrategy": "constraints",
  "publishRepo": "pypi",
  "publishEnvFile": ".env"
}
