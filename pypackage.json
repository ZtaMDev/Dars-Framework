{
  "type": "module",
  "name": "dars_framework",
  "version": "1.3.7",
  "description": "Dars is a Python UI framework for building modern, interactive web apps with only Python code. Write your interface in Python, export it to static HTML/CSS/JS, and deploy anywhere.",
  "authors": [
    {
      "name": "ztamdev",
      "email": "ztadevs@gmail.com"
    }
  ],
  "license": "MIT",
  "dependencies": {
    "rich": "==14.2.0",
    "bs4": "==0.0.2",
    "uvicorn": "==0.38.0",
    "fastapi": "==0.121.1",
    "markdown2": "==2.5.4",
    "requests": "==2.32.5",
    "rjsmin": "==1.2.5"
  },
  "devDependencies": {
    "pydepm": "==1.1.2"
  },
  "optionalDependencies": {},
  "scripts": {},
  "cli": {
    "dars": "dars.cli.main:main"
  },
  "pyproject": {
    "project.license": "MIT",
    "project.readme": "README.md",
    "tool": {
      "setuptools": {
        "packages": {
          "find": {
            "include": [
              "dars*"
            ],
            "exclude": [
              "LandingPage*"
            ]
          }
        }
      }
    }
  },
  "useGlobalDeps": true,
  "autoResolveConflicts": false,
  "autoResolveStrategy": "constraints",
  "publishRepo": "pypi",
  "publishEnvFile": ".env"
}
