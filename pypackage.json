{
  "type": "module",
  "name": "dars-framework",
  "version": "1.2.2",
  "description": "Dars is a Python UI framework for building modern, interactive web apps with only Python code. Write your interface in Python, export it to static HTML/CSS/JS, and deploy anywhere.",
  "authors": [
    {
      "name": "ztamdev",
      "email": "zondax2009@gmail.com"
    }
  ],
  "license": "MIT",
  "dependencies": {
    "rich": "==14.2.0",
    "bs4": "==0.0.2",
    "uvicorn": "==0.35.0",
    "fastapi": "==0.116.1",
    "markdown2": "==2.5.4",
    "requests": "==2.32.5",
    "rjsmin": "==1.2.5"
  },
  "scripts": {
    "dev": "pydep convert --to toml",
    "start": "python dars/templates/examples/basic/HelloWorld/hello_world.py",
    "build": "python uploadPypiScript.py"
  },
  "cli": {
    "dars": "dars.cli.main:main"
  },
  "pyproject": {
    "_raw": "license = 'MIT'\nreadme = 'README.md'\n\n[tool.setuptools.packages.find]\ninclude = ['dars*']\nexclude = ['LandingPage*']\n"
  },
  "useGlobalDeps": true
}
